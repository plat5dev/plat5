# Image pin (ghcr.io/plat5dev/*). Same tag for all five ship images in 0.1.x.
PLAT5_VERSION=v0.1.2

# Postgres (Plat5 runtime DB — keys/orgs only)
POSTGRES_USER=plat5
POSTGRES_PASSWORD=
POSTGRES_DB=plat5

# Route registry admin API (required in prod)
ADMIN_TOKEN=

# JWT IdP (any OIDC-compatible issuer)
AUTH_ISSUER=https://auth.example.com
AUTH_JWKS_URI=https://auth.example.com/.well-known/jwks.json
AUTH_ALLOWED_AUDIENCES=plat5
# Often `sub`; nested custom claims use dotted paths (e.g. properties.user_id)
AUTH_USER_ID_CLAIM=sub

# Optional telemetry (omit to disable export).
# Host process: http://127.0.0.1:4318
# Containers → host Alloy: http://host.docker.internal:4318 (+ extra_hosts via CLI when otel.endpoint set)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318

# Shared secret for gateway → api-keys validate / organizations resolve
INTERNAL_AUTH_TOKEN=

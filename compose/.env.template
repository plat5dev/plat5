# Image pin (ghcr.io/plat5dev/{gateway,identity,control-plane,audit}).
PLAT5_VERSION=v0.7.1

# Postgres (Plat5 runtime DB)
POSTGRES_USER=plat5
POSTGRES_PASSWORD=
POSTGRES_DB=plat5

# Control plane admin API: routes, roles, CORS origins (required in prod)
ADMIN_TOKEN=

# JWT IdP (any OIDC-compatible issuer)
AUTH_ISSUER=https://auth.example.com
AUTH_JWKS_URI=https://auth.example.com/.well-known/jwks.json
AUTH_ALLOWED_AUDIENCES=plat5
# Plat5 Auth (batteries-included): properties.user_id — JWT sub is user:<sha1 prefix>, not the ULID.
# Generic OIDC IdPs (Auth0, etc.): typically sub.
AUTH_USER_ID_CLAIM=properties.user_id

# Optional telemetry (omit to disable export).
# Host process: http://127.0.0.1:4318
# Containers → host Alloy: http://host.docker.internal:4318 (+ extra_hosts via CLI when otel.endpoint set)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318

# Shared secret for gateway → identity validate / resolve
INTERNAL_AUTH_TOKEN=

# Credential brand, identity only. Keys are {brand}-k-2-…, sessions {brand}-s-2-…
# APIKEY_BRAND=plat5

# Roles (docs/roles.md). On by default. compose/roles.yml is written to the
# control plane once, as the first roles document; after that, change roles with
# PUT /roles (plat5 roles apply). ROLES_ENABLED=false turns roles off and leaves
# authorization to something else.
# ROLES_ENABLED=true

# Gateway rate limits (Valkey; replicas share one budget). 0 requests = unlimited fallback.
# Limiter subject follows route scope: public→ip, user→user, organization→org.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_FAILURE_REQUESTS=60
RATE_LIMIT_AUTH_FAILURE_WINDOW_SECONDS=60

# Proxies in front of the gateway (docs/gateway-contract.md#client-ip). Their
# X-Forwarded-For names the client for audit and the IP rate limits. Empty: the
# TCP peer is the client, and X-Forwarded-For is ignored. Behind a tunnel or load
# balancer, list its addresses, or the edge is every request's IP.
# TRUSTED_PROXIES=172.16.0.0/12

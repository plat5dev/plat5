# Image pin (ghcr.io/plat5dev/{gateway,identity,control-plane,audit}).
PLAT5_VERSION=v0.15.1

# Postgres (Plat5 runtime DB)
POSTGRES_USER=plat5
POSTGRES_PASSWORD=
POSTGRES_DB=plat5

# Control plane admin API bearer token (required)
ADMIN_TOKEN=

# JWT IdP (any issuer of signed JWT access tokens)
AUTH_ISSUER=https://auth.example.com
AUTH_JWKS_URI=https://auth.example.com/.well-known/jwks.json
# Required. Comma-separated; * accepts any audience.
AUTH_ALLOWED_AUDIENCES=plat5
# Stable subject claim path. Default: sub (use properties.user_id with Plat5 Auth).
AUTH_SUBJECT_CLAIM=sub
# Comma-separated claim paths checked in order to seed a person's name on first sign-in.
# AUTH_NAME_CLAIMS=name,preferred_username

# Optional modules (both default to true and fail closed if their backing URL is missing).
# AUDIT_ENABLED=true
# RATE_LIMIT_ENABLED=true

# Optional telemetry (omit to disable OTLP push; stdout logs and /metrics stay on).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318

# Secret brand, identity only. Keys are {brand}-k-2-…, invite tokens {brand}-i-1-…
# SECRET_BRAND=plat5

# Gateway admit cache TTLs (durations).
# ADMIT_CACHE_TTL=5m
# ADMIT_NEGATIVE_CACHE_TTL=10s

# Failed-auth IP limiter (active when RATE_LIMIT_ENABLED=true). 0 requests = off.
RATE_LIMIT_AUTH_FAILURE_REQUESTS=60
RATE_LIMIT_AUTH_FAILURE_WINDOW=60s

# Proxies in front of the gateway (docs/reference/gateway.md#client-ip).
# TRUSTED_PROXIES=172.16.0.0/12

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plat5.com/schema/rate_limits.json",
  "title": "Rate limits",
  "description": "Named policies shared by every route that names them.",
  "type": "object",
  "properties": {
    "rate_limits": {
      "title": "rate_limits",
      "description": "Map of policy name → policy.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/policy_name" },
      "additionalProperties": { "$ref": "#/$defs/policy" }
    }
  },
  "$defs": {
    "policy_name": {
      "title": "policy name",
      "description": "`[a-z0-9:._-]+`, max 64. No name is special.",
      "type": "string",
      "pattern": "^[a-z0-9:._-]{1,64}$"
    },
    "policy": {
      "title": "policy",
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "window"],
      "properties": {
        "requests": {
          "title": "requests",
          "description": "Required. Greater than 0.",
          "type": "integer",
          "minimum": 1
        },
        "window": {
          "title": "window",
          "description": "Required. Fixed window length as a duration (`60s`, `1m`).",
          "$ref": "settings.json#/$defs/duration"
        },
        "count_at": {
          "title": "count_at",
          "description": "Optional. A kind: everyone at that kind's node shares one budget. Omitted: each caller has their own budget at the route's node.",
          "$ref": "kinds.json#/$defs/kind_name"
        },
        "tiers": {
          "title": "tiers",
          "description": "Optional. Map of opaque root `rate_limit_tier` name to `{ requests, window }` overrides. Used on kind routes when the resolved root carries a matching tier; falls back to the policy's base `requests` and `window`.",
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/policy_name" },
          "additionalProperties": { "$ref": "#/$defs/tier_limit" }
        }
      }
    },
    "tier_limit": {
      "title": "tier limit",
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "window"],
      "properties": {
        "requests": {
          "title": "requests",
          "description": "Required. Greater than 0.",
          "type": "integer",
          "minimum": 1
        },
        "window": {
          "title": "window",
          "description": "Required. Fixed window length as a duration (`60s`, `1m`).",
          "$ref": "settings.json#/$defs/duration"
        }
      }
    }
  }
}

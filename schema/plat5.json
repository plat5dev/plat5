{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plat5.com/schema/plat5.json",
  "title": "plat5.yml",
  "description": "The deployment's shape: settings, kinds, roles, rate limits and CORS, and the list of service files.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kinds", "roles", "creator_role", "rate_limits"],
  "properties": {
    "deletion_grace": { "$ref": "settings.json#/properties/deletion_grace" },
    "reserved_slugs": { "$ref": "settings.json#/properties/reserved_slugs" },
    "users": { "$ref": "settings.json#/properties/users" },
    "defaults": { "$ref": "settings.json#/properties/defaults" },
    "kinds": { "$ref": "kinds.json#/properties/kinds" },
    "roles": { "$ref": "roles.json#/properties/roles" },
    "creator_role": { "$ref": "roles.json#/properties/creator_role" },
    "rate_limits": { "$ref": "rate_limits.json#/properties/rate_limits" },
    "cors": { "$ref": "cors.json#/properties/cors" },
    "services": {
      "title": "services",
      "description": "The service files, as paths relative to plat5.yml. Each holds one service.",
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}

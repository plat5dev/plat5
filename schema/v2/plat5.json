{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plat5.com/schema/v2/plat5.json",
  "title": "plat5.yml",
  "description": "The deployment's shape: settings, kinds, roles, defaults and CORS, and the list of routes files.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kinds", "roles", "default_role", "creator_role"],
  "properties": {
    "version": { "$ref": "config.json#/properties/version" },
    "deletion_grace": { "$ref": "kinds.json#/properties/deletion_grace" },
    "reserved_slugs": { "$ref": "kinds.json#/properties/reserved_slugs" },
    "kinds": { "$ref": "kinds.json#/properties/kinds" },
    "roles": { "$ref": "roles.json#/properties/roles" },
    "default_role": { "$ref": "roles.json#/properties/default_role" },
    "creator_role": { "$ref": "roles.json#/properties/creator_role" },
    "cors": { "$ref": "cors.json#/properties/cors" },
    "services": {
      "title": "services",
      "description": "The routes files, as paths relative to plat5.yml. Each holds one service.",
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}

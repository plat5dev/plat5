{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plat5.com/schema/v2/config.json",
  "title": "Config",
  "description": "The whole config, as the CLI sends it and the control plane stores it: plat5.yml's keys, with services as a map of service name to service.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kinds", "roles", "default_role", "creator_role"],
  "properties": {
    "version": { "title": "version", "description": "The config format. `2`.", "const": 2 },
    "deletion_grace": { "$ref": "kinds.json#/properties/deletion_grace" },
    "reserved_slugs": { "$ref": "kinds.json#/properties/reserved_slugs" },
    "kinds": { "$ref": "kinds.json#/properties/kinds" },
    "roles": { "$ref": "roles.json#/properties/roles" },
    "default_role": { "$ref": "roles.json#/properties/default_role" },
    "creator_role": { "$ref": "roles.json#/properties/creator_role" },
    "cors": { "$ref": "cors.json#/properties/cors" },
    "services": {
      "title": "services",
      "description": "Map of service name → service.",
      "type": "object",
      "propertyNames": { "$ref": "routes.json#/$defs/service_name" },
      "additionalProperties": { "$ref": "routes.json#/$defs/service" }
    }
  }
}

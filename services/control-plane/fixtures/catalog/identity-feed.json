{
  "revision": 1,
  "deletion_grace": "30d",
  "reserved_slugs": [
    "new",
    "settings",
    "api",
    "admin"
  ],
  "users": {
    "name": {
      "claims": [
        "name",
        "preferred_username"
      ],
      "sync": "first_sign_in"
    }
  },
  "kinds": {
    "environment": {
      "parent": "project",
      "path": "/envs/{environment}",
      "list_permission": "environment:read"
    },
    "organization": {
      "path": "/orgs/{organization}",
      "list_permission": "organization:read"
    },
    "project": {
      "parent": "organization",
      "path": "/projects/{project}",
      "list_permission": "project:read"
    }
  },
  "roles": {
    "admin": {
      "permissions": [
        "*"
      ],
      "bindable_at": [
        "organization",
        "project",
        "environment"
      ]
    },
    "developer": {
      "permissions": [
        "project:create",
        "project:read",
        "project:write",
        "project:bindings:read"
      ],
      "includes": [
        "member"
      ],
      "bindable_at": [
        "organization",
        "project"
      ]
    },
    "member": {
      "permissions": [
        "organization:read"
      ],
      "bindable_at": [
        "organization"
      ]
    }
  },
  "creator_role": "admin"
}

{
  "deletion_grace": "30d",
  "reserved_slugs": ["new", "settings", "api", "admin"],
  "users": { "name_claim": "name" },
  "kinds": {
    "organization": { "path": "/orgs/{organization}" },
    "project": { "parent": "organization", "path": "/projects/{project}", "bind_creator": false },
    "environment": { "parent": "project", "path": "/envs/{environment}", "permission_name": "project", "bind_creator": false }
  },
  "roles": {
    "admin": { "permissions": ["*"], "bindable_at": ["organization", "project", "environment"] },
    "member": { "permissions": ["organization:read"], "bindable_at": ["organization"] },
    "developer": {
      "includes": ["member"],
      "permissions": ["project:read", "project:write", "project:bindings:read"],
      "bindable_at": ["organization", "project", "environment"]
    },
    "viewer": {
      "includes": ["member"],
      "permissions": ["project:read"],
      "bindable_at": ["organization", "project", "environment"]
    }
  },
  "creator_role": "admin",
  "rate_limits": { "default": { "requests": 100, "window_seconds": 1 } },
  "services": {
    "identity": {
      "url": "http://identity:3000",
      "kinds": {
        "project": { "resources": { "service_accounts": false } },
        "environment": { "resources": { "invites": false, "bindings": { "methods": { "POST": false } } } }
      }
    },
    "audit": { "url": "http://audit:3002" }
  }
}

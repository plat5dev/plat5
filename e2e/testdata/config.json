{
  "deletion_grace": "30d",
  "reserved_slugs": ["new", "settings", "api", "admin"],
  "users": { "name_claim": "name" },
  "kinds": {
    "organization": { "path": "/orgs/{organization}", "list_permission": "organization:read" },
    "project": { "parent": "organization", "path": "/projects/{project}", "list_permission": "project:read" }
  },
  "roles": {
    "admin": { "permissions": ["*"], "bindable_at": ["organization", "project"] },
    "member": { "permissions": ["organization:read"], "bindable_at": ["organization"] },
    "developer": {
      "includes": ["member"],
      "permissions": ["project:create", "project:read", "project:write", "project:bindings:read"],
      "bindable_at": ["organization", "project"]
    }
  },
  "creator_role": "admin",
  "rate_limits": { "default": { "requests": 100, "window_seconds": 1 } },
  "services": {
    "identity": { "url": "http://identity:3000" },
    "audit": { "url": "http://audit:3002" }
  }
}
